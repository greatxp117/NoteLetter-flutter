# Uncomment this line to define a global platform for your project
platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

# F-122 — the share extension (ios/Share; tool/add_share_target.rb). It signs in
# through FirebaseAuth and files through fn_* over URLSession: Auth is the one
# Firebase product it links, because an extension pays memory for every
# framework it carries. It asks for Auth EXACTLY as FlutterFire's firebase_auth
# asks for Runner — the umbrella subspec at the family's version, READ from
# firebase_core's firebase_sdk_version.rb — so the two resolve one Firebase.
# Never a literal `pod 'FirebaseAuth', 'x.y.z'`: one stayed at 12.17.0 and
# blocked the eMudhra fix, and a product's own pod need not exist at the
# family's version (12.19.3 patched Core and Firestore; FirebaseAuth is
# 12.19.0, which `Firebase/Auth` 12.19.3 asks for as `~> 12.19.0`).
require File.join(File.dirname(File.realpath(__FILE__)),
                  '.symlinks', 'plugins', 'firebase_core', 'ios', 'firebase_sdk_version.rb')
target 'Share' do
  platform :ios, '16.0'
  use_frameworks!
  pod 'Firebase/Auth', firebase_sdk_version!
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    # Xcode 27.1 accepts deployment targets 15.0 and up only, and a pod that
    # still declares 9.0–13.0 (GoogleSignIn, gRPC, abseil…) is a build ERROR,
    # which `flutter build ios` reports with no cause (2026-10-29). The app's
    # own floor is 15.0, so raising a pod to it changes nothing the app runs on.
    target.build_configurations.each do |config|
      if config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'].to_f < 15.0
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
      end
    end
  end
end
